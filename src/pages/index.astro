---
import Layout from '../layouts/Layout.astro';
import LineField from '../components/LineField.astro';
import StudyDrawing from '../components/StudyDrawing.astro';
import MusicWave from '../components/MusicWave.astro';
import '@fontsource/anton/latin-400.css';
import '../styles/kinetic.css';
import ExperienceIcon from '../components/ExperienceIcon.astro';
import { experience, awards, skills } from '../data/profile';
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/`;
---
<Layout variant="kinetic">
<div class="reading-progress" aria-hidden="true"></div>
<header class="site-header">
 <a class="wordmark" href="#home" aria-label="Mingliang Lyu home">ml<span>.</span></a>
 <span class="header-location">Hong Kong / Beijing</span>
 <nav aria-label="Main navigation">
  <button class="menu-toggle" aria-expanded="false" aria-controls="nav-links"><span></span><span></span><span class="sr-only">Toggle navigation</span></button>
  <div id="nav-links" class="nav-links"><a href="#experience">Experience</a><a href="#exploring">Exploring</a><a href="#about">About</a><a href="#contact" class="nav-contact">Let’s talk <span aria-hidden="true">↗</span></a></div>
 </nav>
</header>
<main id="main">
<section id="home" class="hero section">
 <div class="hero-field"><LineField /><div class="field-caption"><span>Space, connected.</span><span>An exploration of structure &amp; intelligence</span></div><p class="hero-domains"><span>Building simulation</span><span>Digital twins</span><span>AI agents</span></p></div>
 <div class="hero-name-band"><h1 aria-label="Mingliang Lyu">Mingliang Lyu<span class="name-dot">.</span></h1></div>
 <div class="hero-introduction"><div class="hero-personal"><p class="intro">Hi, I’m</p><p class="name-note">You can call me Eric.</p></div><div class="hero-direction"><h2>Exploring intelligence <br/>in the built world.</h2><p class="interest-lead">I’m interested in</p><p class="interest-fields"><span>Data science</span><span>Operations research</span><span>AI</span></p><p class="hero-description">and how they help us understand and improve complex systems, especially in the built environment.</p></div></div>
 <div class="hero-bottom"><span class="hero-note">Curious by nature. Building by choice.</span><a class="button" href="#experience">Explore my experience <span aria-hidden="true">↗</span></a></div>
 <a href="#experience" class="scroll-link">A little further down <span aria-hidden="true">↓</span></a>
</section>
<section id="experience" class="section experience-section">
 <div class="section-heading reveal"><div><p class="eyebrow">Where I’ve been</p><h2>Ideas meet<br/>the real world.</h2></div><p class="section-description">Across buildings, simulation, and AI.<br/>A few places where I’ve put curiosity to work.</p></div>
 <div class="experience-list">{experience.map(item=><details class="experience reveal" open={item.open}>
  <summary><ExperienceIcon kind={item.icon} /><span class="experience-title"><span class="org-name">{item.org}</span><span class="role">{item.role}</span></span><span class="experience-time">{item.time}</span><span class="expand-icon" aria-hidden="true"></span></summary>
  <div class="experience-body"><span class="work-category">{item.category}</span><h3>{item.title}</h3>{item.supervisor&&<p class="supervisor">Working with {item.supervisor}</p>}{item.story&&<div class="experience-story">{item.story.map(paragraph=><p>{paragraph}</p>)}</div>}{item.points.length>0&&<ul>{item.points.map(point=><li>{point}</li>)}</ul>}{item.tags.length>0&&<div class="tags">{item.tags.map(tag=><span>{tag}</span>)}</div>}</div>
 </details>)}</div>
</section>
<section class="statement section" aria-label="Personal perspective"><p>{'Understand the system. Explore what it could become.'.split(' ').map(word=><span class="reveal-word">{word} </span>)}</p><span class="statement-caption">Data to insight. Models to decisions.</span></section>
<section id="exploring" class="section exploring-section">
 <div class="section-heading reveal"><div><p class="eyebrow">On my desk</p><h2>Still exploring.</h2></div><p class="section-description">A closer look at what I’m working on.<br/>Questions in progress, with room to grow.</p></div>
 <div class="exploration-grid">
  <article class="exploration-card reveal"><div class="work-visual room-visual"><StudyDrawing kind="spatial" /><span class="visual-label">Spatial study · Illustrative</span></div><div class="work-copy"><p class="work-category">Digital twins / PolyU</p><h3>ZB202, connected.</h3><p>ZB202 is a laboratory in PolyU’s Z Core, and our base for digital twin research. We’re connecting the lab’s spatial model, IoT sensor data, and browser interface to study the relationship between the physical space and its digital representation.</p><span class="status"><span></span>Currently developing</span></div></article>
  <article class="exploration-card reveal"><div class="work-visual airflow-visual"><StudyDrawing kind="airflow" /><span class="visual-label">Thermal &amp; airflow study · Illustrative</span></div><div class="work-copy"><p class="work-category">Building simulation / Tsinghua</p><h3>Heat, air, and everything between.</h3><p>Using MOOSAS to represent building topology and explore automated performance optimization by changing how spaces connect. Coupled thermal and airflow simulation with CONTAM helps evaluate the effects of those changes, alongside field measurement validation.</p><span class="status"><span></span>Research in progress</span></div></article>
 </div>
</section>
<section id="about" class="section about-section">
 <div class="section-heading reveal"><div><p class="eyebrow">A bit of background</p><h2>Foundations.<br/>And forward motion.</h2></div><p class="section-description">An engineering education.<br/>An applied mathematics perspective.</p></div>
 <div class="background-grid"><article class="education reveal"><span class="work-category">Education</span><h3>The Hong Kong <br/>Polytechnic University</h3><p>BEng (Hons) in Building Sciences and Engineering</p><p class="muted">Minor in Applied Mathematics</p><div class="education-bottom"><span>2024 — Present</span><span class="top-percent">Top 5%</span></div></article>
 <div class="awards reveal"><h3>Recognition</h3>{awards.map(a=><div class="award"><span class="award-year">{a.year}</span><div><h4>{a.name}</h4><p>{a.detail}</p></div></div>)}</div></div>
 <div id="skills" class="skills-section reveal"><div class="skills-heading"><h3>Tools I think & build with.</h3><p>From data and models to spaces and systems.</p></div><div class="skills-grid">{skills.map(group=><div class="skill-group"><h4>{group.title}</h4><div>{group.items.map(item=><span>{item}</span>)}</div>{group.note&&<p class="skill-note">{group.note}</p>}</div>)}</div></div>
</section>
<section class="section life-section" id="life"><div class="section-heading reveal"><div><p class="eyebrow">Away from the desk</p><h2>There’s more<br/>to the story.</h2></div><p class="section-description">Sometimes on stage.<br/>Sometimes out on the court.</p></div><div class="life-grid">
 <article class="life-card music-card reveal"><div class="music-art"><MusicWave /></div><div><span class="work-category">Music</span><h3>Keys. Strings. Live stages.</h3><p>Piano, with a DipABRSM along the way. Bass guitar, a band, and multiple livehouse performances.</p><div class="tags"><span>Piano</span><span>Bass</span><span>Live music</span></div></div></article>
 <article class="life-card sport-card reveal"><div class="sport-art" aria-hidden="true"><svg viewBox="0 0 400 190" fill="none"><g stroke="#89baff" stroke-opacity=".6"><rect x="45" y="25" width="310" height="140" rx="70"/><rect x="57" y="37" width="286" height="116" rx="58"/><rect x="69" y="49" width="262" height="92" rx="46"/><rect x="81" y="61" width="238" height="68" rx="34"/><path d="M200 25V165"/></g><path class="runner-route" d="M115 31 H285 A64 64 0 0 1 285 159 H115 A64 64 0 0 1 115 31 Z" stroke="none"/><circle class="runner-dot" cx="0" cy="0" r="5" fill="#c2dcff"/></svg></div><div><span class="work-category">Movement</span><h3>Always in motion.</h3><p>I used to play competitive baseball, but have since stepped away from competition. These days, I enjoy basketball and running.</p><div class="tags"><span>Basketball</span><span>Running</span><span>Baseball</span></div></div></article>
 </div></section>
<section id="contact" class="section contact-section reveal"><p class="eyebrow">Keep the conversation going</p><h2>Good things start<br/>with a hello<span>.</span></h2><a class="email-link" href="mailto:mingliang.lv@connect.polyu.hk">mingliang.lv@connect.polyu.hk <span aria-hidden="true">↗</span></a><a class="github-link" href="https://github.com/LYUml" target="_blank" rel="noopener noreferrer">Find me on GitHub <span aria-hidden="true">↗</span></a></section>
</main>
<footer class="section footer"><a class="wordmark" href="#home" aria-label="Back to top">ml<span>.</span></a><p>© {new Date().getUTCFullYear()} Mingliang Lyu</p><div><a href={`${base}privacy/`}>Privacy</a><a href="#home">Back to top ↑</a></div></footer>
<script>
import '../scripts/kinetic';
const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');
const links=document.querySelector<HTMLElement>('#nav-links');
const background=Array.from(document.querySelectorAll<HTMLElement>('main,footer,.site-header>.wordmark'));
const closeMenu=()=>{background.forEach(el=>el.inert=false);menu?.setAttribute('aria-expanded','false');links?.classList.remove('is-open');document.body.classList.remove('menu-open');};
menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));links?.classList.toggle('is-open',open);document.body.classList.toggle('menu-open',open);background.forEach(el=>el.inert=open);if(open)links?.querySelector<HTMLAnchorElement>('a')?.focus();});
links?.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
document.addEventListener('keydown',e=>{if(e.key==='Tab'&&menu?.getAttribute('aria-expanded')==='true'){const targets=[menu,...Array.from(links?.querySelectorAll<HTMLAnchorElement>('a')??[])];const first=targets[0],last=targets[targets.length-1];if(e.shiftKey&&document.activeElement===first){e.preventDefault();last?.focus();}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first?.focus();}}if(e.key==='Escape'&&menu?.getAttribute('aria-expanded')==='true'){closeMenu();menu.focus();}});
matchMedia('(min-width: 761px)').addEventListener('change',e=>{if(e.matches)closeMenu();});
const navLinks=Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-links a'));
const sections=['home','experience','exploring','about','contact'].map(id=>document.getElementById(id)).filter((x):x is HTMLElement=>!!x);
const navObserver=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(entry.isIntersecting){navLinks.forEach(a=>{const active=a.hash===`#${entry.target.id}`;a.classList.toggle('active',active);if(active)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});document.dispatchEvent(new CustomEvent('navigation-active'));}});},{rootMargin:'-15% 0px -55% 0px'});
sections.forEach(section=>navObserver.observe(section));
</script>
</Layout>
