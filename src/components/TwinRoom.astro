---
import {demoSensors, roomProjection} from '../data/demo-sensors';
interface Props {digital?:boolean}
const {digital=false}=Astro.props;
const project=roomProjection;
const points=(coords:number[][])=>coords.map(c=>project(c[0],c[1],c[2]||0).join(',')).join(' ');
const edges=(coords:number[][])=>'M'+coords.map(c=>project(c[0],c[1],c[2]||0).join(' ')).join('L');
const sensors=demoSensors.map(s=>s.position);
---
<svg viewBox="0 0 440 310" fill="none" aria-hidden="true" class:list={['twin-room',{digital}]}>
 <g stroke="currentColor" stroke-width="1.3" stroke-linejoin="round">
  <polygon points={points([[0,0],[300,0],[300,220],[0,220]])} fill={digital?'#000':'#11110f'}/>
  <polygon points={points([[0,0],[0,220],[0,220,120],[0,0,120]])} fill={digital?'#000':'#1c1c18'}/>
  <polygon points={points([[0,220],[300,220],[300,220,120],[0,220,120]])} fill={digital?'#000':'#141412'}/>
  <g stroke-opacity=".18" stroke-width=".7">{[60,120,180,240].map(x=><path d={edges([[x,0],[x,220]])}/>)}{[55,110,165].map(y=><path d={edges([[0,y],[300,y]])}/>)}</g>
  <!-- Window in the left wall and wall-mounted HVAC unit. -->
  <polygon points={points([[0,48,40],[0,172,40],[0,172,103],[0,48,103]])} fill="#000"/>
  <path d={edges([[0,110,40],[0,110,103]])} stroke-opacity=".5"/>
  <polygon points={points([[155,219,78],[252,219,78],[252,219,103],[155,219,103]])} fill="#000"/>
  <path d={edges([[162,218,84],[245,218,84]])}/>
  <!-- Entrance door and magnetic contact on the left wall. -->
  <polygon points={points([[0,3,0],[0,43,0],[0,43,98],[0,3,98]])} fill="#000"/>
  <path d={edges([[0,8,4],[0,38,4],[0,38,93],[0,8,93],[0,8,4]])} stroke-opacity=".5"/>
  <circle cx={project(0,12,44)[0]} cy={project(0,12,44)[1]} r="1.6" fill="currentColor"/>
  <polygon points={points([[23,204,1],[41,204,1],[41,216,1],[23,216,1]])} fill="#000"/>
  <!-- Two workstations: desktop, monitor, keyboard, legs and task chair. -->
  {[{x:47,y:100},{x:178,y:100}].map(({x,y})=><g>
   <path d={edges([[x,y,47],[x,y,0]])}/><path d={edges([[x+86,y,47],[x+86,y,0]])}/><path d={edges([[x+86,y+59,47],[x+86,y+59,0]])}/>
   <polygon points={points([[x,y,47],[x+86,y,47],[x+86,y+59,47],[x,y+59,47]])} fill={digital?'#000':'#272720'}/>
   <polygon points={points([[x+20,y+44,49],[x+68,y+44,49],[x+68,y+44,81],[x+20,y+44,81]])} fill="#000"/>
   <path d={edges([[x+44,y+44,49],[x+44,y+44,42]])}/>
   <polygon points={points([[x+20,y+9,48],[x+65,y+9,48],[x+65,y+23,48],[x+20,y+23,48]])} stroke-opacity=".5"/>
   <polygon points={points([[x+26,y-41,26],[x+63,y-41,26],[x+63,y-12,26],[x+26,y-12,26]])} fill="#000"/>
   <polygon points={points([[x+26,y-41,26],[x+63,y-41,26],[x+63,y-41,55],[x+26,y-41,55]])} fill="#000"/>
   <path d={edges([[x+45,y-25,26],[x+45,y-25,6],[x+27,y-36,0]])}/><path d={edges([[x+45,y-25,6],[x+64,y-15,0]])}/>
  </g>)}
  <!-- Ceiling lights and an IoT gateway on the near side. -->
  <g stroke-opacity=".5"><polygon points={points([[66,120,124],[130,120,124],[130,136,124],[66,136,124]])}/><polygon points={points([[188,120,124],[252,120,124],[252,136,124],[188,136,124]])}/></g>
  <polygon points={points([[246,22,0],[281,22,0],[281,46,0],[246,46,0]])} fill="#000"/>
  <path d={edges([[253,27,0],[253,27,23]])}/><path d={edges([[276,37,0],[276,37,23]])}/>
 </g>
 <g class="twin-network" stroke="currentColor" stroke-width=".9" stroke-opacity={digital?'.65':'.3'} stroke-dasharray="3 5">
  {sensors.map(([x,y,z])=><path d={edges([[x,y,z],[263,33,23]])}/>)}
 </g>
 <g class="sensor-points" fill="currentColor">{demoSensors.map(sensor=>{const [cx,cy]=project(...sensor.position as [number,number,number]);return <g data-sensor-marker={sensor.id}><circle cx={cx} cy={cy} r="3"/><circle class="sensor-ring" cx={cx} cy={cy} r="8" fill="none" stroke="currentColor" stroke-opacity=".55" stroke-width=".8"/></g>})}</g>
 {digital&&<g stroke="currentColor" stroke-opacity=".4" stroke-dasharray="2 5"><path d={edges([[0,0,120],[300,0,120],[300,220,120]])}/><path d={edges([[300,0],[300,0,120]])}/></g>}
</svg>
