 <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
  {kind === 'control' && <><path d="M5 26V9l12-4v21M5 26h22M17 12h9v14M9 12h3m-3 5h3m-3 5h3"/><path d="M20 18h3v4h-3z"/><circle cx="24" cy="7" r="2"/><path d="M20 7h2m2 2v3"/></>}
  {kind === 'airflow' && <><path d="M5 11V6h22v5M5 23v3h22v-3M16 6v6m0 9v5" opacity=".6"/><path d="M3 15c4-5 7 5 12 0s8 5 14 0M3 20c4-5 7 5 12 0s8 5 14 0"/></>}
  {kind === 'evaluation' && <><path d="M5 6h19a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H13l-7 5v-5H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z" opacity=".6"/><path d="M8 15v2m5-6v6m5-9v9m4-3 2 2 4-5"/></>}
  {kind === 'geometry' && <><path d="m5 11 14-6 9 7-14 7zM5 11v12l9 5 14-7v-9M14 19v9M19 5v12M5 23l14-6 9 4"/><circle cx="14" cy="19" r="2" fill="#181818"/></>}
