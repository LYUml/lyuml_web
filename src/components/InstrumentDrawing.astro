---
// Original vector study. Bass proportions follow the user's natural-finish five-string photo.
const frets = Array.from({length:24},(_,i)=>76+158*(1-Math.pow(2,-(i+1)/12)));
const whiteKeys = 29;
---
<svg class="instrument-drawing" viewBox="0 0 600 320" fill="none" aria-hidden="true">
 <g class="piano-lines" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round">
  <!-- Open grand piano: curved rim, lifted lid, harp and foreshortened keyboard. -->
  <path d="M41 186L112 133L153 59C186 40 229 41 254 60C270 73 269 94 285 109C300 125 329 122 340 141C351 160 336 179 314 190L126 239Z" fill="#080808"/>
  <path d="M112 133L153 59C186 40 229 41 254 60C270 73 269 94 285 109C300 125 329 122 340 141L254 158Z" stroke-opacity=".55"/>
  <path d="M126 227L314 178C338 166 347 153 340 141 M126 239V250L314 201V190 M41 186V199L126 250 M41 199L126 239 M112 133L254 158L126 227Z"/>
  <!-- Raised lid is one continuous grand-piano silhouette. -->
  <path d="M113 129L145 32C176 13 219 17 248 35C267 47 265 68 281 82C299 97 326 95 340 115L254 151Z" fill="#000"/>
  <path d="M113 129L254 151L340 115 M145 32L254 151 M148 38C176 22 216 27 242 41C259 51 259 71 276 87C292 102 318 101 329 113" stroke-opacity=".4"/>
  <path d="M254 151L265 176"/>
  <!-- Soundboard and strings visible below the lid. -->
  <g stroke-width=".6" stroke-opacity=".48">{Array.from({length:15},(_,i)=><path d={`M${124+i*7} ${148+i*.7}L${137+i*10} ${212-i*2.6}`}/>)}</g>
  <path d="M47 180L124 213L142 202L65 169Z" fill="currentColor"/>
  <path d="M47 180L124 213L142 202 M47 180V190L124 224L142 213V202 M124 213V224"/>
  <!-- Proper alternating 2/3 black-key groups. -->
  {Array.from({length:whiteKeys+1},(_,i)=>{const t=i/whiteKeys;return <path d={`M${47+77*t} ${180+33*t}L${65+77*t} ${169+33*t}`} stroke="#000" stroke-width=".65"/>})}
  {Array.from({length:whiteKeys},(_,i)=>[0,1,3,4,5].includes(i%7)&&<path d={`M${65+77*(i+.7)/whiteKeys} ${169+33*(i+.7)/whiteKeys}l-11 6.7`} stroke="#000" stroke-width="3.5"/>)}
  <path d="M49 201L49 267L58 271L66 209 M132 249L132 292L141 294L151 244 M312 203L309 255L317 257L328 197" fill="#000"/>
  <path d="M154 248L173 257L163 279 M166 259L184 265 M171 265L168 278 M180 269L177 282" stroke-opacity=".75"/>
  <!-- Bench, separated from the piano silhouette. -->
  <path d="M35 250L77 232L112 247L70 266Z M35 250V256L70 272L112 253V247 M42 260V287 M69 272V300 M104 257V285" fill="#000"/>
 </g>
 <!-- Trace-inspired bass: offset Jazz body, long upper horn, short lower horn. -->
 <g class="bass-lines" transform="translate(390 8) scale(.72 1)" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" stroke-linecap="round">
  <path d="M77 177C62 180 55 163 54 148C53 136 49 133 43 135C30 140 30 165 33 181C36 198 29 210 23 227C16 250 12 271 27 283C41 294 61 290 77 291C101 294 126 298 139 286C154 273 145 250 138 232C132 217 132 207 135 194C140 171 136 158 130 158C123 156 123 177 109 184C99 189 91 184 91 173Z" fill="#0a0a09"/>
  <!-- Clear pickguard follows the offset waist rather than enclosing the whole body. -->
  <path d="M69 163C67 181 65 192 59 203C49 219 51 230 66 234L94 237C107 241 122 259 139 270C134 247 126 235 126 216C124 203 134 184 130 167C125 183 112 192 94 188L91 172" stroke-opacity=".55" stroke-width=".8"/>
  <!-- Maple neck, heel and curved Fender-style headstock. -->
  <path d="M77 197L77 60L70 55C64 52 66 43 68 35L70 22C69 11 76 1 85 1C96 1 99 12 99 18C86 23 89 36 91 45L91 197Q85 203 77 197Z" fill="#000"/>
  <path d="M77 60H91 M77 64H91 M77 194H91"/>
  {frets.map(y=><path d={`M77 ${y}H91`} stroke-opacity=".52" stroke-width=".65"/>)}
  {[94,118,139,156,171,185].map(y=><rect x="79" y={y} width="10" height="2.3" fill="currentColor" opacity=".32" stroke="none"/>)}
  <!-- Five inline tuners and five strings. -->
  {[12,22,32,42,52].map((y,i)=><g><path d={`M${76-i*.4} ${y}H${64-i*.4}`}/><path d={`M${64-i*.4} ${y-2}c-7-7-10-1-7 2c-3 4 2 8 7 2Z`} stroke-width=".8"/><circle cx={79+i*.7} cy={y} r="2" stroke-width=".7"/></g>)}
  <!-- Chrome pickup cover, exposed bridge pickup and five-saddle bridge. -->
  <rect x="64" y="211" width="42" height="11" rx="4" fill="#000"/><path d="M67 212V221 M72 212V221 M97 212V221 M103 212V221" stroke-opacity=".5"/>
  <rect x="67" y="246" width="36" height="7" rx="1" fill="#000"/>
  <path d="M65 271H106V287H65Z" fill="#000"/>
  {Array.from({length:5},(_,i)=><g><path d={`M${78+i*3} 62L${74+i*6} 284`} stroke-width=".55"/><path d={`M${72+i*6} 274h4v9h-4Z`} stroke-width=".7"/><circle cx={72+i*6} cy="249.5" r=".65" fill="currentColor"/></g>)}
  {[{x:116,y:234},{x:123,y:246},{x:131,y:258},{x:138,y:271}].map(p=><g><circle cx={p.x} cy={p.y} r="3.3" fill="#000"/><path d={`M${p.x-1} ${p.y-1.8}l1.4 1.4`} stroke-width=".7"/></g>)}
  <g stroke-opacity=".35" stroke-width=".7"><path d="M41 193C48 207 28 230 32 259 M42 212C42 231 27 257 40 278 M49 247C43 263 50 281 57 285 M111 269C122 273 127 280 124 287"/></g>
  <path d="M27 291L25 298 M135 293L138 300"/>
 </g>
 <g class="sound-lines" transform="translate(0 4)" stroke="currentColor" stroke-width="1" opacity=".65">{Array.from({length:41},(_,i)=>{const h=4+Math.abs(Math.sin(i*.73)*Math.sin(i*.24))*24;return <path d={`M${38+i*7} ${8-h/2}V${8+h/2}`}/>})}</g>
</svg>
