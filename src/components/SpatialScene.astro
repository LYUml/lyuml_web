<div class="spatial-scene" aria-hidden="true">
  <canvas id="spatial-canvas"></canvas>
  <span class="scene-caption">Space, connected.</span>
  <span class="scene-coordinate">An exploration of structure & intelligence</span>
</div>
<script>
const canvas = document.querySelector<HTMLCanvasElement>('#spatial-canvas');
if (canvas) {
 const ctx = canvas.getContext('2d');
 if (ctx) {
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const small = matchMedia('(max-width: 760px)');
  let w=0,h=0,t=0,frame=0,visible=true,pointer=0,targetPointer=0,left=0,paused=document.documentElement.dataset.motion==='paused';
  canvas.dataset.sceneState='idle';
  const project=(x:number,y:number,z:number) => {
   const a=-0.5 + pointer*0.22 + Math.sin(t*.12)*.16;
   const xx=x*Math.cos(a)-z*Math.sin(a),zz=x*Math.sin(a)+z*Math.cos(a);
   const s=Math.min(w/13,h/10);
   return [w*0.52+xx*s,h*0.52+(zz*0.4-y)*s];
  };
  const line=(a:number[],b:number[],color:string,width=1) => {
   const aa=project(a[0],a[1],a[2]),bb=project(b[0],b[1],b[2]);
   ctx.beginPath();ctx.moveTo(aa[0],aa[1]);ctx.lineTo(bb[0],bb[1]);ctx.strokeStyle=color;ctx.lineWidth=width;ctx.stroke();
  };
  const draw=()=>{
   ctx.clearRect(0,0,w,h);
   const assembly=(reduced.matches||paused)?1:1-Math.pow(1-Math.min(t/2.4,1),3);
   ctx.globalAlpha=(reduced.matches||paused)?1:Math.min(1,t/.8);
   for(let x=-6;x<=6;x++) line([x,-2,-5],[x,-2,5],'rgba(132,161,205,.10)');
   for(let z=-5;z<=5;z++) line([-6,-2,z],[6,-2,z],'rgba(132,161,205,.10)');
   const levels=[-1.7,-0.35,1,2.35].map((y,i)=>y+(i-1.5)*1.8*(1-assembly));
   levels.forEach((y,i)=>{
    const corners=[[-3,y,-2.1],[3,y,-2.1],[3,y,2.1],[-3,y,2.1]];
    const pts=corners.map(a=>project(a[0],a[1],a[2]));
    ctx.beginPath();pts.forEach((a,j)=>j?ctx.lineTo(a[0],a[1]):ctx.moveTo(a[0],a[1]));ctx.closePath();ctx.fillStyle='rgba(137,186,255,.035)';ctx.fill();
    corners.forEach((a,j)=>line(a,corners[(j+1)%4],i===3?'rgba(177,206,246,.65)':'rgba(137,186,255,.38)'));
    for(let x=-3;x<=3;x+=1.5) line([x,y,-2.1],[x,y,2.1],'rgba(137,186,255,.13)');
    if(i<3) [-3,0,3].forEach(x=>[-2.1,2.1].forEach(z=>line([x,y,z],[x,levels[i+1],z],'rgba(137,186,255,.45)')));
   });
   for(let i=0;i<9;i++){
    const a=t*0.22+i*Math.PI*2/9;
    const x=Math.cos(a)*4.7,z=Math.sin(a)*3.6,y=0.25+Math.sin(a*2)*.65;
    const pt=project(x,y,z);
    line([x,y,z],[x*.6,0.35,z*.5],'rgba(137,186,255,.15)');
    ctx.beginPath();ctx.arc(pt[0],pt[1],i%3===0?3:2,0,Math.PI*2);ctx.fillStyle=i%3===0?'#c9e0ff':'#89baff';ctx.fill();
   }
   const orbit:number[][]=[];
   for(let i=0;i<=100;i++){const a=i*Math.PI*2/100;orbit.push(project(Math.cos(a)*4.7,.25+Math.sin(a*2)*.65,Math.sin(a)*3.6));}
   ctx.beginPath();orbit.forEach((a,i)=>i?ctx.lineTo(a[0],a[1]):ctx.moveTo(a[0],a[1]));ctx.strokeStyle='rgba(137,186,255,.18)';ctx.stroke();
  };
  const resize=()=>{const box=canvas.getBoundingClientRect();w=box.width;h=box.height;left=box.left;const d=Math.min(devicePixelRatio,2);canvas.width=w*d;canvas.height=h*d;ctx.setTransform(d,0,0,d,0,0);draw();};
  let last=0;
  const tick=(now:number)=>{frame=0;if(!visible||document.hidden||reduced.matches||paused)return;if(now-last>(small.matches?65:32)){t+=Math.min((now-last)/1000,.1);last=now;pointer+=(targetPointer-pointer)*.08;draw();canvas.dataset.sceneTime=t.toFixed(2);}frame=requestAnimationFrame(tick);};
  const start=()=>{if(!frame&&visible&&!document.hidden&&!reduced.matches&&!paused){last=performance.now();canvas.dataset.sceneState='running';frame=requestAnimationFrame(tick);}};
  new ResizeObserver(resize).observe(canvas);
  new IntersectionObserver(([entry])=>{visible=entry.isIntersecting;if(visible)start();else{cancelAnimationFrame(frame);frame=0;canvas.dataset.sceneState='paused';}}).observe(canvas);
  canvas.parentElement?.addEventListener('pointermove',e=>{if(reduced.matches||paused||small.matches)return;targetPointer=Math.max(-.5,Math.min(.5,(e.clientX-left)/w-.5));});
  canvas.parentElement?.addEventListener('pointerleave',()=>{targetPointer=0;});
  document.addEventListener('motion-preference',(event)=>{paused=(event as CustomEvent<{paused:boolean}>).detail.paused;cancelAnimationFrame(frame);frame=0;canvas.dataset.sceneState='paused';draw();start();});
  document.addEventListener('visibilitychange',()=>{if(document.hidden){cancelAnimationFrame(frame);frame=0;canvas.dataset.sceneState='paused';}else start();});
  reduced.addEventListener('change',()=>{cancelAnimationFrame(frame);frame=0;canvas.dataset.sceneState='paused';draw();start();});
 }
}
</script>
